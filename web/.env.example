# Address of the .NET API (no trailing slash). Leave empty to run the site on the bundled content only.
VITE_API_URL=
# Cloudflare Turnstile site key for the request form. Leave empty to skip the bot check.
VITE_TURNSTILE_SITE_KEY=
# Public address of the site, used in link previews, the sitemap and robots.txt.
VITE_SITE_URL=https://danielalkabbout.pages.dev
