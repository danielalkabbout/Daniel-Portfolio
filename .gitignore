# ---------- Secrets and local settings (never commit these) ----------
appsettings.Development.json
appsettings.Local.json
appsettings.*.local.json
*.pfx
*.p12
secrets.json
.env
.env.*
!.env.example

# ---------- React / Node (web/) ----------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- OS files ----------
.DS_Store
Thumbs.db
desktop.ini