# ---------- .NET build output ----------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Ll]og/
[Ll]ogs/
artifacts/
publish/
*.nupkg
*.snupkg

# ---------- .NET tests and coverage ----------
TestResults/
[Tt]est[Rr]esult*/
coverage*.json
coverage*.xml
*.coverage
*.trx

# ---------- Visual Studio / Rider / VS Code ----------
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
